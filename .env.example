# Ballast environment template. Copy to .env and fill in. Never commit .env.
# Stage 1 needs no wallet keys and no exchange keys.

# --- App ---
APP_ENV=local
APP_LOG_LEVEL=INFO

# --- Database (PostgreSQL) ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ballast
DB_USER=ballast
DB_PASSWORD=change-me-local-only

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- Chains (Alchemy free tier) ---
CHAIN_ENABLED=ethereum,arbitrum,base
RPC_URL_ETHEREUM=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
RPC_URL_ARBITRUM=https://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
RPC_URL_BASE=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# --- Data collection ---
SNAPSHOT_INTERVAL_MINUTES=15

# --- Fork simulation (Anvil) ---
FORK_TOLERANCE_PCT=0.3

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456789:YOUR_BOT_TOKEN
TELEGRAM_CHAT_ID=123456789

# --- Paper portfolio / allocation (defaults from docs/decisions.md) ---
PAPER_CAPITAL_USD=10000
RESERVE_PCT=5
MAX_PROTOCOL_PCT=35
MAX_TIER_B_PCT=25
MAX_TIER_B_ASSET_PCT=15
MAX_MATURITY_DAYS=183
MAX_GAS_PCT_OF_POSITION=0.3
TIER_A_PREMIUM_PP=2
TIER_B_PREMIUM_PP=6

# --- Stage 3 only: dashboard admin (placeholders) ---
DASHBOARD_ADMIN_USER=admin
DASHBOARD_ADMIN_PASSWORD=change-me

# --- Stage 2 only (executor container only). Leave empty until Stage 2. ---
# HOT_WALLET_KEY_FILE=/run/secrets/hot_wallet_key
# OWNER_ADDRESS=0xYOUR_HARDWARE_WALLET_ADDRESS
